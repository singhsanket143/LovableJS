{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "resolveJsonModule": true,
      "declaration": false,
      "sourceMap": true
    },
    "include": ["src", "generated/prisma"]
}